# Copy these into your host's private "Variables" (Railway) — or into a file named .env for local testing.
# Never share this file or post it anywhere.

# ---------- Required ----------
NODE_ENV=production

# Any long random text (40+ characters). Signs login sessions.
SESSION_SECRET=

# Your admin login for /admin
ADMIN_USERNAME=
# Either set ADMIN_PASSWORD (simplest — works from a phone), or the more private
# ADMIN_PASSWORD_HASH made with:  node hash-password.js "YourPassword"
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# ---------- Where data and photos are kept ----------
# On Railway: set this to /storage and attach ONE volume mounted at /storage.
# Products, orders, customers, sessions, backups and photos all live inside it and survive redeploys.
# Leave blank for local testing (uses the project folders).
STORAGE_DIR=
# Already have a volume with data in it (e.g. mounted at /app/data)? Keep it: leave STORAGE_DIR blank and set
#   UPLOAD_DIR=/app/data/uploads
# (DATA_DIR / UPLOAD_DIR let you point at exact folders and take priority over STORAGE_DIR.)
DATA_DIR=
UPLOAD_DIR=

# ---------- Strongly recommended ----------
# Encrypts customer names, phone numbers and addresses on disk. Any long random text (40+ characters),
# or generate one with:  node setup-encryption.js
# Set it BEFORE you take real orders, and back it up somewhere safe — if it's lost, encrypted data is unreadable.
ENCRYPTION_KEY=

# ---------- Optional ----------
# 2FA for /admin. Generate with:  node setup-2fa.js   (or see README for the no-computer way)
ADMIN_TOTP_SECRET=

# Email alert to you when an order arrives. Customers are NOT emailed (accounts use phone numbers).
# Note: Railway's Hobby plan blocks outgoing email (SMTP), so this only works on other plans/hosts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SELLER_EMAIL=
